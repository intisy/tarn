if(DEFINED ENV{TMPDIR})
    set(base "$ENV{TMPDIR}")
elseif(DEFINED ENV{TEMP})
    set(base "$ENV{TEMP}")
else()
    set(base /tmp)
endif()
string(RANDOM LENGTH 8 suffix)
set(working "${base}/tarn-hook-${suffix}")
file(COPY "${TREE}/" DESTINATION "${working}")
if(NOT DEFINED START)
    set(START .)
endif()
if(DEFINED UNLISTED)
    foreach(number RANGE 1 ${UNLISTED})
        file(WRITE "${working}/docs/note-${number}.md" "A note nothing lists.\n")
    endforeach()
endif()
execute_process(COMMAND ${CMAKE_COMMAND} -E env "TARN_CHECK=${CHECKER}" "${BASH}" "${HOOK}"
    WORKING_DIRECTORY "${working}/${START}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
file(REMOVE_RECURSE "${working}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "the hook exited ${result}, expected 0\n${output}${errors}")
endif()
string(REGEX REPLACE "\n$" "" trimmed "${output}")
if(trimmed STREQUAL "")
    set(line_count 0)
else()
    string(REGEX MATCHALL "\n" breaks "${trimmed}")
    list(LENGTH breaks break_count)
    math(EXPR line_count "${break_count} + 1")
endif()
if(NOT line_count EQUAL EXPECTED_LINES)
    message(FATAL_ERROR "the hook printed ${line_count} lines, expected ${EXPECTED_LINES}\n${output}${errors}")
endif()
string(REPLACE "\n" ";" output_lines "${output}")
set(has_matching_line FALSE)
foreach(output_line IN LISTS output_lines)
    if(output_line MATCHES "${HAS}")
        set(has_matching_line TRUE)
    endif()
endforeach()
if(DEFINED HAS AND NOT has_matching_line)
    message(FATAL_ERROR "the hook printed no text matching ${HAS}\n${output}${errors}")
endif()
