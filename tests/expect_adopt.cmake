set(DESTINATION "${WORKING}")
include("${PREPARE}")
execute_process(COMMAND "${PROGRAM}" adopt repo --standard-ref "${STANDARD_REF}" --write "${WORKING}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "tarn-check adopt repo --write exited ${result}, expected 0\n${output}${errors}")
endif()
if(NOT output MATCHES "^create docs/VERSION\n")
    message(FATAL_ERROR "tarn-check adopt repo --write printed no plan starting with create docs/VERSION\n${output}")
endif()
file(READ "${WORKING}/.github/workflows/docs.yml" caller)
string(FIND "${caller}" "uses: intisy/tarn/.github/workflows/check-docs.yml@${STANDARD_REF}\n" found)
if(found EQUAL -1)
    message(FATAL_ERROR "the written caller does not call check-docs.yml at ${STANDARD_REF}\n${caller}")
endif()
execute_process(COMMAND "${PROGRAM}" "${WORKING}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "tarn-check on the adopted tree exited ${result}, expected 0\n${output}${errors}")
endif()
