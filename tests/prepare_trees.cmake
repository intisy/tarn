set(directory_link "${DESTINATION}/directory-link/src/loop")
set(directory_link_target "${DESTINATION}/directory-link/src")

function(remove_directory_link)
    if(NOT IS_SYMLINK "${directory_link}" AND NOT IS_DIRECTORY "${directory_link}")
        return()
    endif()
    if(CMAKE_HOST_WIN32)
        file(TO_NATIVE_PATH "${directory_link}" native_link)
        execute_process(COMMAND cmd /c rmdir "${native_link}" RESULT_VARIABLE result)
    else()
        file(REMOVE "${directory_link}")
        set(result 0)
    endif()
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "could not remove the directory link ${directory_link}")
    endif()
endfunction()

function(create_directory_link)
    if(CMAKE_HOST_WIN32)
        file(TO_NATIVE_PATH "${directory_link}" native_link)
        file(TO_NATIVE_PATH "${directory_link_target}" native_target)
        execute_process(COMMAND cmd /c mklink /J "${native_link}" "${native_target}"
            RESULT_VARIABLE result OUTPUT_QUIET)
    else()
        file(CREATE_LINK "${directory_link_target}" "${directory_link}" RESULT result SYMBOLIC)
    endif()
    if(NOT result EQUAL 0 OR NOT IS_DIRECTORY "${directory_link}/loop")
        message(FATAL_ERROR "could not create the directory link ${directory_link}: ${result}")
    endif()
endfunction()

remove_directory_link()
file(REMOVE_RECURSE "${DESTINATION}")
file(COPY "${SOURCE}/" DESTINATION "${DESTINATION}")

file(GLOB_RECURSE fixture_files LIST_DIRECTORIES false "${DESTINATION}/*.fixture")
foreach(fixture_file IN LISTS fixture_files)
    string(REGEX REPLACE "\\.fixture$" "" real_name "${fixture_file}")
    file(RENAME "${fixture_file}" "${real_name}")
endforeach()

file(GLOB_RECURSE dotted_files LIST_DIRECTORIES false "${DESTINATION}/dot-*")
foreach(dotted_file IN LISTS dotted_files)
    get_filename_component(folder "${dotted_file}" DIRECTORY)
    get_filename_component(name "${dotted_file}" NAME)
    string(REGEX REPLACE "^dot-" "." real_name "${name}")
    file(RENAME "${dotted_file}" "${folder}/${real_name}")
endforeach()

if(IS_DIRECTORY "${DESTINATION}/directory-link")
    create_directory_link()
endif()
