string(REPLACE "|" ";" arguments "${ARGUMENTS}")
execute_process(COMMAND "${PROGRAM}" ${arguments} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT "${result}" STREQUAL "${EXPECTED}")
    message(FATAL_ERROR "tarn-check ${arguments} exited ${result}, expected ${EXPECTED}\n${output}${errors}")
endif()
if(DEFINED HAS AND NOT output MATCHES "${HAS}")
    message(FATAL_ERROR "tarn-check ${arguments} printed no line matching ${HAS}\n${output}${errors}")
endif()
if(DEFINED LACKS AND output MATCHES "${LACKS}")
    message(FATAL_ERROR "tarn-check ${arguments} printed a line matching ${LACKS}\n${output}${errors}")
endif()
