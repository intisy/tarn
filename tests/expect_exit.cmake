if(DEFINED GIT_LOG)
    file(REMOVE "${GIT_LOG}")
endif()
string(REPLACE "|" ";" arguments "${ARGUMENTS}")
execute_process(COMMAND "${PROGRAM}" ${arguments} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT "${result}" STREQUAL "${EXPECTED}")
    message(FATAL_ERROR "tarn-check ${arguments} exited ${result}, expected ${EXPECTED}\n${output}${errors}")
endif()
if(DEFINED HAS AND NOT output MATCHES "${HAS}")
    message(FATAL_ERROR "tarn-check ${arguments} printed no line matching ${HAS}\n${output}${errors}")
endif()
if(DEFINED HAS_ALSO AND NOT output MATCHES "${HAS_ALSO}")
    message(FATAL_ERROR "tarn-check ${arguments} printed no line matching ${HAS_ALSO}\n${output}${errors}")
endif()
if(DEFINED LACKS AND output MATCHES "${LACKS}")
    message(FATAL_ERROR "tarn-check ${arguments} printed a line matching ${LACKS}\n${output}${errors}")
endif()
if(DEFINED GIT_LOG AND DEFINED GIT_CALLS)
    set(logged "")
    if(EXISTS "${GIT_LOG}")
        file(READ "${GIT_LOG}" logged)
    endif()
    if(GIT_CALLS STREQUAL none AND NOT logged STREQUAL "")
        message(FATAL_ERROR "tarn-check ${arguments} called git, which it must not:
${logged}")
    endif()
    if(GIT_CALLS STREQUAL some AND logged STREQUAL "")
        message(FATAL_ERROR "tarn-check ${arguments} never called the git stub, so the log proves nothing")
    endif()
endif()
