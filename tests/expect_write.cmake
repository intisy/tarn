file(REMOVE_RECURSE "${WORKING}")
file(COPY "${TREE}/" DESTINATION "${WORKING}")
execute_process(COMMAND "${PROGRAM}" --write "${WORKING}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "tarn-check --write exited ${result}, expected 0\n${output}${errors}")
endif()
file(READ "${WORKING}/${FILE}" actual HEX)
file(READ "${TREE}/.expected/${FILE}" expected HEX)
if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "${FILE} was not regenerated to .expected/${FILE}")
endif()
